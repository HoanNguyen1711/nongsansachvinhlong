{$DOMAIN_NAME} {
    # Encode responses with Gzip or Zstandard
    encode gzip zstd

    # Serve compressed WebP agricultural images directly via Caddy for max performance
    handle_path /static/uploads/* {
        root * /var/www/static/uploads
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Route all API requests to the FastAPI backend container
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Route all other requests (UI, assets, SSG pages) to the Next.js frontend container
    handle /* {
        reverse_proxy frontend:3000
    }
}
